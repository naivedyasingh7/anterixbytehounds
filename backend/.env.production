# AgriVerify AI - Production Environment Configuration
PROJECT_NAME="AgriVerify AI API"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false
PORT=8000
HOST="0.0.0.0"

# Production Supabase / PostgreSQL Connection Pooler (Port 6543 Transaction Mode)
DATABASE_URL="postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# Authentication & Security (Must be generated via: openssl rand -hex 32)
JWT_SECRET="generate_a_secure_256bit_production_secret_key_here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Strict CORS Whitelist for Production
CORS_ORIGINS=["https://agriverify.in","https://app.agriverify.in"]

# Copernicus Data Space Ecosystem (CDSE) / Sentinel Hub Credentials
MOCK_SATELLITE_SERVICE=false
SENTINEL_STAC_URL="https://earth-search.aws.element84.com/v1"
COPERNICUS_CDSE_CLIENT_ID=""
COPERNICUS_CDSE_CLIENT_SECRET=""
