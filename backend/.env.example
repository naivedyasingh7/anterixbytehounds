ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","*"]

# Geospatial & Satellite Mock Settings
MOCK_SATELLITE_SERVICE=true
SENTINEL_API_KEY=""
EARTH_ENGINE_CREDENTIALS=""
