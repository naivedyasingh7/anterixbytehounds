# AgriVerify AI - Environment Template
PROJECT_NAME="AgriVerify AI API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database Configuration (PostgreSQL / Supabase with SQLite fallback)
# For Local Postgres: postgresql://postgres:agriverify_password@localhost:5432/agriverify
# For Supabase Pooler: postgresql://postgres.xxx:xxx@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:agriverify_password@localhost:5432/agriverify"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# Authentication & Security
JWT_SECRET="agriverify_super_secret_jwt_key_2026_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","*"]

# Satellite & Earth Observation
MOCK_SATELLITE_SERVICE=false
SENTINEL_STAC_URL="https://earth-search.aws.element84.com/v1"
COPERNICUS_CDSE_CLIENT_ID=""
COPERNICUS_CDSE_CLIENT_SECRET=""
