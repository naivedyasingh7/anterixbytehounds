# Server Configuration
PROJECT_NAME="AgriVerify AI API"
VERSION="1.0.0"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# Database Configuration (PostgreSQL with PostGIS)
DATABASE_URL="postgresql://postgres:agriverify_password@localhost:5432/agriverify"

# Authentication & Security
JWT_SECRET="agriverify_super_secret_jwt_key_2026_change_in_production"
